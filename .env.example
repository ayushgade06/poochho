# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Bolna (LIVE mode only) ---
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional caller ID; must be a number in your Bolna account.
BOLNA_FROM_NUMBER=
# Shared secret Bolna sends on every webhook. Agent → Extractions → Webhook → Add headers:
#   {"x-poochho-secret": "<this value>"}
BOLNA_WEBHOOK_SECRET=
# Optional source-IP allowlist (documented Bolna IPs): 13.203.39.153,13.126.9.249,13.202.133.53
BOLNA_WEBHOOK_IPS=

# --- Safety controls ---
# LIVE mode stays off unless this is "true" AND the Bolna values AND POOCHHO_ADMIN_TOKEN are set.
LIVE_CALLS_ENABLED=false
# Operator token (12+ chars) required for live calls, labelling and exports.
POOCHHO_ADMIN_TOKEN=
MAX_CALLS_PER_REQUEST=5
MAX_CONCURRENCY=8
MAX_LIVE_CALLS_PER_DAY=25
CALL_WINDOW_IST=09:00-20:00
CALL_WATCHDOG_SECONDS=300

# --- Sarvam (optional voice input/output; browser speech is the fallback) ---
SARVAM_API_KEY=
# Sarvam voice input is open to everyone within these daily caps (per visitor = hashed IP); the operator is not capped.
VOICE_INPUTS_PER_IP_PER_DAY=20
VOICE_INPUTS_PER_DAY=300
# Typed sentences turned into form fields by Sarvam (the home page box), capped separately.
TEXT_INPUTS_PER_IP_PER_DAY=60
TEXT_INPUTS_PER_DAY=1000

# --- Judge mode: the judge plays one shop in their own browser (Bolna Web Call SDK) ---
WEB_CALL_ENABLED=false
JUDGE_CALLS_PER_IP_PER_DAY=3
JUDGE_CALLS_PER_DAY=30
